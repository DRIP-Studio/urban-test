{
  "name": "@drip-urban/web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-cesium": "node scripts/copy-cesium.mjs && node scripts/copy-maplibre.mjs",
    "dev": "npm run prepare-cesium && vite",
